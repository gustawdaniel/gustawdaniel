---
import type {InferEntrySchema} from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import CommentsSection from "../components/blog/CommentsSection.astro";
import EditPageButton from "../components/github/EditPageButton.astro";

interface Props {
    id: string;
    frontmatter: InferEntrySchema<"note">;
    body: string;
}

const {id, frontmatter} = Astro.props;

const description = `Dev note: ${frontmatter.title}`;
---

<BaseLayout pageTitle={frontmatter.title} description={description}>
    <article class="container px-2 my-4 sm:my-10 lg:my-20 m-auto">
        <header class="mb-20">
            <section class="prose lg:prose-xl m-auto dark:prose-invert">

                    <h1 >{frontmatter.title}</h1>

            </section>
        </header>

        <section class="prose lg:prose-xl m-auto dark:prose-invert">
            <slot/>
        </section>

        <aside class="my-20">
            <div class="mb-5 prose lg:prose-xl m-auto">
                <EditPageButton id={`note/${id}`}/>
            </div>

            <CommentsSection/>
        </aside>

    </article>

    <script>
        // Un-proxy remote and SVG images from Astro's /_image endpoint
        document.querySelectorAll('article section.prose img').forEach(img => {
            const src = img.getAttribute('src');
            if (src && src.includes('/_image?href=')) {
                const match = src.match(/href=([^&]+)/);
                if (match && match[1]) {
                    const rawUrl = decodeURIComponent(match[1]);
                    img.setAttribute('src', rawUrl);
                    img.removeAttribute('srcset');
                    img.removeAttribute('width');
                    img.removeAttribute('height');
                    img.removeAttribute('data-image-component');
                }
            }
        });

        // Wrap markdown tables in overflow container for mobile responsiveness
        document.querySelectorAll('article section.prose table').forEach(table => {
            if (!table.parentElement.classList.contains('table-wrapper')) {
                const wrapper = document.createElement('div');
                wrapper.className = 'table-wrapper overflow-x-auto max-w-full my-6';
                table.parentNode.insertBefore(wrapper, table);
                wrapper.appendChild(table);
            }
        });

        // Add anchor links to headings
        document.querySelectorAll('article section.prose h2[id], article section.prose h3[id]').forEach(heading => {
            if (heading.querySelector('.anchor-link')) return;
            const link = document.createElement('a');
            link.className = 'anchor-link inline-block ml-2 text-indigo-500 opacity-0 group-hover:opacity-100 hover:text-indigo-600 transition-opacity no-underline text-base font-normal align-middle';
            link.href = `#${heading.id}`;
            link.ariaLabel = 'Link to section';
            link.title = 'Copy link to section';
            link.innerHTML = '🔗';
            heading.classList.add('group');
            heading.appendChild(link);
        });
    </script>
</BaseLayout>