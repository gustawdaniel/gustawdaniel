---
import type { Project } from '../../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const currentLocale = Astro.currentLocale as 'en' | 'pl' | 'es';

const content = currentLocale === 'pl' && project.pl
  ? project.pl
  : currentLocale === 'es' && project.es
  ? project.es
  : project;

const description = content.description;
const bullets = content.bullets;
---

<article class="bg-white dark:bg-slate-800/80 rounded-2xl border border-gray-200/80 dark:border-slate-700/80 p-6 md:p-8 shadow-sm hover:shadow-md transition-all duration-200">
  <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
    <h3 class="text-xl md:text-2xl font-bold text-gray-900 dark:text-white tracking-tight">
      {project.title}
    </h3>
    {project.year && (
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 border border-blue-200/60 dark:border-blue-800/60">
        {project.year}
      </span>
    )}
  </div>

  {description && (
    <div class="prose dark:prose-invert max-w-none text-gray-600 dark:text-gray-300 text-base mb-5 whitespace-pre-line leading-relaxed">
      {description}
    </div>
  )}

  {bullets && bullets.length > 0 && (
    <div class="mb-6">
      <ul class="space-y-2">
        {bullets.map((bullet) => (
          <li class="flex items-start gap-2.5 text-sm md:text-base text-gray-700 dark:text-gray-300">
            <svg class="w-5 h-5 shrink-0 text-blue-500 dark:text-blue-400 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>{bullet}</span>
          </li>
        ))}
      </ul>
    </div>
  )}

  {project.imgs && project.imgs.length > 0 && (
    <div class="my-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
      {project.imgs.map((imgSrc, idx) => (
        <a href={imgSrc} target="_blank" rel="noopener noreferrer" class="group relative block overflow-hidden rounded-xl border border-gray-200 dark:border-slate-700 bg-gray-50 dark:bg-slate-900">
          <img
            src={imgSrc}
            alt={`${project.title} screenshot ${idx + 1}`}
            loading="lazy"
            class="w-full h-48 md:h-64 object-cover object-top transition-transform duration-300 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-black/30 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white text-xs font-medium gap-1">
            <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
            </svg>
            View full size
          </div>
        </a>
      ))}
    </div>
  )}

  {project.links && project.links.length > 0 && (
    <div class="mt-4 pt-4 border-t border-gray-100 dark:border-slate-700/60 flex flex-wrap gap-3">
      {project.links.map((linkUrl) => (
        <a
          href={linkUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg bg-gray-100 dark:bg-slate-700 hover:bg-gray-200 dark:hover:bg-slate-600 text-gray-800 dark:text-gray-100 transition-colors"
        >
          <svg class="size-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
          </svg>
          <span>{linkUrl.replace('https://github.com/', '')}</span>
        </a>
      ))}
    </div>
  )}
</article>
