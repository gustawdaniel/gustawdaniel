---
import { projects } from '../../data/projects';
import ProjectCard from './ProjectCard.astro';

const currentLocale = Astro.currentLocale as 'en' | 'pl' | 'es';

const title = currentLocale === 'pl' 
  ? 'Projekty i Portfolio' 
  : currentLocale === 'es' 
  ? 'Proyectos y Portafolio' 
  : 'Projects & Portfolio';

const subtitle = currentLocale === 'pl'
  ? 'Wybrane projekty programistyczne, algorytmy wysokiej wydajności, platformy AI oraz wkład w oprogramowanie open-source.'
  : currentLocale === 'es'
  ? 'Sistemas de ingeniería de software seleccionados, algoritmos de alto rendimiento, plataformas de IA y contribuciones de código abierto.'
  : 'Selected software engineering systems, high-performance algorithms, AI platforms, and open-source contributions.';
---

<div class="bg-white dark:bg-slate-900 py-12 sm:py-20">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center mb-12 sm:mb-16">
      <h1 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl">
        {title}
      </h1>
      <p class="mt-4 text-lg leading-8 text-gray-600 dark:text-gray-300">
        {subtitle}
      </p>
    </div>

    <div class="space-y-8 max-w-4xl mx-auto">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </div>
</div>
