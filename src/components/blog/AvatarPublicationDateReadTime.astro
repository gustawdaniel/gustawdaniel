---
import type { InferEntrySchema } from "astro:content";

import { prettyDate } from "../../helpers/prettyDate";
import { readingTime } from "../../helpers/readingTime";

interface Props {
  data: InferEntrySchema<"blog">;
  body: string;
}

const { data, body } = Astro.props;
const locale = Astro.currentLocale ?? "en";
---

<div class="not-prose relative mt-8 flex items-center gap-x-4">
  <img
    src="https://preciselab.fra1.digitaloceanspaces.com/blog/img/411d6d7d-6a1e-4096-9a88-fc16a9978f2e.avif"
    alt={data.author}
    width="512"
    height="512"
    class="!my-0 !mx-0 !h-10 !w-10 !max-w-none rounded-full bg-gray-100 object-cover flex-shrink-0"
    loading="lazy"
  />

  <div class="text-sm leading-6">
    <p class="!my-0 font-semibold text-gray-900 dark:text-gray-100">
      <span>
        <span class=""></span>
        {data.author}
      </span>
    </p>
    <p class="!my-0 text-gray-500 dark:text-gray-400">
      <time datetime="2020-03-16" class="text-gray-500 dark:text-gray-400"
        >{prettyDate(data.publishDate, locale)}</time
      >
      <span class="mx-1 text-gray-400 dark:text-gray-500">•</span>
      <span>{readingTime(body)} read</span>
    </p>
  </div>
</div>
