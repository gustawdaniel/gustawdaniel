---
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
    tag: string;
    className?: string;
}

const { tag, className } = Astro.props;
const locale = Astro.currentLocale ?? 'en';
const tagUrl = getRelativeLocaleUrl(locale, `tags/${encodeURIComponent(tag.toLowerCase())}`);
---

<a
    href={tagUrl}
    class:list={[
        'inline-flex items-center capitalize rounded-full bg-slate-100 text-slate-700 hover:bg-slate-200 border border-slate-200/80 dark:bg-slate-800/90 dark:text-slate-200 dark:hover:bg-slate-700 dark:border-slate-700/80 cursor-pointer px-3 py-1 font-medium text-xs transition-colors duration-150 relative z-20',
        className ? className : ''
    ]}
>
    #{tag}
</a>