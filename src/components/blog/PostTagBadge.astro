---
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
    tag: string;
    className?: string;
}

const { tag, className } = Astro.props;
const locale = Astro.currentLocale ?? 'en';
const tagUrl = getRelativeLocaleUrl(locale, `tags/${encodeURIComponent(tag.toLowerCase())}`);
---

<a
    href={tagUrl}
    class:list={[
        'inline-flex items-center capitalize rounded-full bg-slate-100 text-slate-700 hover:bg-slate-200 border border-slate-200/80 dark:bg-[#0D0F31] dark:text-[#59E1E3] dark:hover:bg-[#1B1D4C] dark:hover:text-[#46BDFF] dark:border-[#FF16B0]/40 cursor-pointer px-3 py-1 font-medium text-xs transition-colors duration-150 relative z-20',
        className ? className : ''
    ]}
>
    #{tag}
</a>