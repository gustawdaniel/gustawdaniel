---
import {getCollection, type CollectionEntry} from "astro:content";

const locale = Astro.currentLocale ?? 'en';

const rawDevNotes: CollectionEntry<"note">[] = await getCollection(
    'note',
    (note) => note.id.startsWith(locale)
);

const sortedDevNotes = rawDevNotes.sort(
    (a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);

import {prettyDate} from "../../helpers/prettyDate";
import {readingTime} from "../../helpers/readingTime";
import {computeMarkdownStatistics} from "../../helpers/computeMarkdownStatistics";
import PostTagBadge from "../blog/PostTagBadge.astro";
import {useTranslations} from "../../i18n/utils";

const enhancedDevNotes = sortedDevNotes.map(note => {
    return {
        ...note,
        markdownStatistics: computeMarkdownStatistics(note.body || ''),
    }
});

const titles: Record<string, { title: string; subtitle: string }> = {
    en: { title: "Dev notes", subtitle: "Short form with concise instructions or solutions worth sharing." },
    pl: { title: "Notatki programistyczne", subtitle: "Krótkie formy ze zwięzłymi instrukcjami i rozwiązaniami problemów." },
    es: { title: "Notas de desarrollo", subtitle: "Formato corto con instrucciones concisas o soluciones para compartir." }
};
const header = titles[locale] || titles.en;
---

<div class="bg-white dark:bg-slate-900 py-12 sm:py-20 border-b border-gray-100 dark:border-slate-800">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center">
            <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">{header.title}</h2>
            <p class="mt-3 text-lg leading-8 text-gray-600 dark:text-gray-300">{header.subtitle}</p>
        </div>
    </div>
</div>

<div class="bg-white dark:bg-slate-900 py-8 min-h-[50vh]">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <ul role="list" class="divide-y divide-gray-200/80 dark:divide-slate-800">
            {enhancedDevNotes.map(note => (
                <li class="relative py-6 hover:bg-slate-50/80 dark:hover:bg-slate-800/60 rounded-xl transition-colors px-4 my-1">
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                        <div class="min-w-0 flex-1">
                            <a href={`/notes/${note.id}`} class="group">
                                <h3 class="text-lg font-semibold leading-6 text-gray-900 dark:text-gray-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
                                    {note.data.title}
                                </h3>
                            </a>
                            <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-gray-500 dark:text-gray-400">
                                <time datetime={note.data.publishDate.toISOString()}>
                                    {prettyDate(note.data.publishDate, locale)}
                                </time>
                                <span>•</span>
                                <span>{readingTime(note.body || '')} read</span>
                                <span>•</span>
                                <span>{note.markdownStatistics}</span>
                            </div>
                            {note.data.tags && note.data.tags.length > 0 && (
                                <div class="mt-3 flex flex-wrap gap-2">
                                    {note.data.tags.map(tag => (
                                        <PostTagBadge tag={tag} />
                                    ))}
                                </div>
                            )}
                        </div>
                    </div>
                </li>
            ))}
        </ul>
    </div>
</div>