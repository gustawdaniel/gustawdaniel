---
import {getCollection, type CollectionEntry} from "astro:content";
const locale = Astro.currentLocale ?? 'en';

interface Props {
    featured: boolean;
    reducer?: (collection: CollectionEntry<"blog">[]) => CollectionEntry<"blog">[];
}

const {featured, reducer} = Astro.props;

import { getRelativeLocaleUrl } from 'astro:i18n';
import {stripLang} from "../helpers/i18n/stripLang";
import {fixBlogLocale} from "../helpers/i18n/fixBlogLocale";

const rawBlogPosts: CollectionEntry<"blog">[] = await getCollection(
    'blog',
    (post) => post.id.startsWith(locale)
);

const sortedBlogPosts = rawBlogPosts.sort(
    (a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);

import PostCoverOnList from "./blog/PostCoverOnList.astro";
import PostDescriptionOnList from "./blog/PostDescriptionOnList.astro";
import FirstPostCardOnList from "./blog/FirstPostCardOnList.astro";

const postsToDisplay = reducer ? reducer(sortedBlogPosts) : sortedBlogPosts;
const firstPost = featured && postsToDisplay.length > 0 ? postsToDisplay[0] : null;
const remainingPosts = featured && postsToDisplay.length > 0 ? postsToDisplay.slice(1) : postsToDisplay;
---


<div class="bg-white dark:bg-slate-900">
    <div class="mx-auto max-w-7xl px-2 sm:px-6 lg:px-8">


        <!--<div class="grid  lg:mx-0 lg:max-w-none lg:grid-cols-3 max-w-2xl mx-auto">-->

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 sm:gap-x-8 gap-y-10 sm:gap-y-20 sm:mt-16 ">

            {firstPost && <FirstPostCardOnList article={firstPost} />}
            {remainingPosts.map(p => {
                const postUrl = fixBlogLocale(getRelativeLocaleUrl(locale, 'posts/' + locale + stripLang(p.id)), locale);
                return (
                    <article class="flex flex-col items-start justify-between border-b border-gray-200/80 dark:border-slate-800/80 pb-8 sm:border-0 sm:pb-0">
                        <a href={postUrl} class="w-full">
                            <PostCoverOnList data={p.data} />
                        </a>
                        <PostDescriptionOnList data={p.data} body={p.body || ''} postUrl={postUrl} />
                    </article>
                );
            })}
        </div>



        <!--</div>-->
    </div>
</div>


